<Project Sdk="Microsoft.NET.Sdk">

  <!-- The runtime that generated clients use: HTTP execution, parameter serialization, results and typed errors,
       JSON helpers, authentication handlers and dependency injection. It never references the generation engine. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Msynk.BlazorApi.Runtime</PackageId>
    <Description>Runtime for BlazorApi-generated OpenAPI clients: HTTP execution, OpenAPI parameter serialization, typed results and errors, authentication handlers and HttpClientFactory integration.</Description>
    <RootNamespace>BlazorApi.Runtime</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlazorApi.Runtime.Tests" />
  </ItemGroup>

</Project>
