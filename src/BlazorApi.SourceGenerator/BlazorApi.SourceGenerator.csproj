<!-- Publish settings passed on the command line for an app flow to every referenced project; a netstandard2.0
     analyzer cannot be trimmed or published, so it ignores them. -->
<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishTrimmed;PublishAot;SelfContained;RuntimeIdentifier">

  <!-- The Roslyn incremental source generator. It compiles the OpenAPI engine and the C# code generator in (they are
       dependency-free and netstandard2.0), so the analyzer has no assembly dependencies to load. File I/O sources are
       excluded: contracts arrive as MSBuild AdditionalFiles. Roslyn 4.8 is the compiler of the .NET 8 SDK. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>BlazorApi.SourceGenerator</PackageId>
    <Description>Generates typed OpenAPI clients, models and mocks at build time from contracts added with &lt;OpenApiContract Include="..." /&gt;.</Description>
    <RootNamespace>BlazorApi.SourceGenerator</RootNamespace>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);RS2008;CS1591;NU5128</NoWarn>
    <!-- The package carries only the analyzer and MSBuild files (no lib assets). Its one package dependency is
         BlazorApi.Runtime, which the generated code compiles against (declared in the .nuspec). -->
    <NuspecFile>BlazorApi.SourceGenerator.nuspec</NuspecFile>
    <IncludeSymbols>false</IncludeSymbols>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier></RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\BlazorApi.OpenApi\**\*.cs" Exclude="..\BlazorApi.OpenApi\IO\**;..\BlazorApi.OpenApi\obj\**;..\BlazorApi.OpenApi\bin\**" LinkBase="Engine\OpenApi" />
    <Compile Include="..\BlazorApi.CodeGeneration\**\*.cs" Exclude="..\BlazorApi.CodeGeneration\obj\**;..\BlazorApi.CodeGeneration\bin\**" LinkBase="Engine\CodeGeneration" />
  </ItemGroup>

  <!-- The package is described by BlazorApi.SourceGenerator.nuspec: NuGet derives dependencies only from restored
       references, and the analyzer must not reference the runtime, so the dependency on BlazorApi.Runtime (same
       version) is declared there. Metadata comes from Directory.Build.props through NuspecProperties. -->
  <Target Name="BlazorApiNuspecProperties" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <NuspecProperties>id=$(PackageId);version=$(PackageVersion);authors=$(Authors);copyright=$(Copyright);projectUrl=$(PackageProjectUrl);repositoryUrl=$(RepositoryUrl);tags=$(PackageTags.Replace(';', ' '));assembly=$(MSBuildProjectDirectory)/$(OutputPath)$(AssemblyName).dll;readme=$(MSBuildThisFileDirectory)../../README.md</NuspecProperties>
    </PropertyGroup>
  </Target>

</Project>
