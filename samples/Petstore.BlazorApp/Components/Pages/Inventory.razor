@page "/inventory"
@inject IPetstoreClient Api

<h1>Inventory</h1>

@* getInventory needs the API key, which the registered handler adds for this operation only. *@
<ApiResultView TValue="IReadOnlyDictionary<string, int>" @ref="_view" Load="ct => Api.GetInventoryResultAsync(ct)" KeepPreviousValue="true">
    <ChildContent Context="inventory">
        <ul>
            @foreach (var pair in inventory.OrderBy(p => p.Key))
            {
                <li>@pair.Key: @pair.Value</li>
            }
        </ul>
    </ChildContent>
</ApiResultView>

<button type="button" @onclick="RefreshAsync">Refresh</button>

@code {
    private ApiResultView<IReadOnlyDictionary<string, int>>? _view;

    private Task RefreshAsync() => _view?.ReloadAsync() ?? Task.CompletedTask;
}
