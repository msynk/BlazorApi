@page "/"
@inject IPetstoreClient Api

<h1>Pets</h1>

@* Cursor pagination with the generated client: each page carries the cursor of the next one. *@
@if (_listError is { } error)
{
    <ApiErrorView Error="error" OnRetry="ReloadAsync" />
}
else if (_pets is null)
{
    <p aria-busy="true">Loading...</p>
}
else
{
    <ul>
        @foreach (var pet in _pets)
        {
            <li>
                <a href="pets/@pet.Id">@pet.Name</a>
                (@pet.Kind@(pet is Cat { Indoor: true } ? ", indoor" : string.Empty))
            </li>
        }
    </ul>

    @if (_nextCursor is not null)
    {
        <button type="button" disabled="@_loading" @onclick="LoadMoreAsync">Load more</button>
    }
}

<h2>Add a pet</h2>

@* Client-side rules come from the contract (DataAnnotations); server-side errors (422 problem details) appear on
   the same fields through ApiValidationErrors. Try an empty name or a kind the server rejects. *@
<EditForm Model="_new" OnValidSubmit="CreateAsync" FormName="new-pet">
    <DataAnnotationsValidator />
    <ApiValidationErrors Error="_createError" />
    <ValidationSummary />

    <label>Name <InputText @bind-Value="_new.Name" /></label>
    <ValidationMessage For="() => _new.Name" />

    <label>
        Kind
        <InputSelect @bind-Value="_new.Kind">
            <option value="dog">Dog</option>
            <option value="cat">Cat</option>
            <option value="parrot">Parrot (rejected by the server)</option>
        </InputSelect>
    </label>
    <ValidationMessage For="() => _new.Kind" />

    <button type="submit" disabled="@_creating">Add</button>
</EditForm>

@code {
    private const int PageSize = 5;

    private List<Pet>? _pets;
    private string? _nextCursor;
    private bool _loading;
    private ApiError? _listError;
    private NewPet _new = NewModel();
    private ApiError? _createError;
    private bool _creating;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync()
    {
        _pets = null;
        _nextCursor = null;
        return LoadPageAsync(cursor: null);
    }

    private Task LoadMoreAsync() => LoadPageAsync(_nextCursor);

    private async Task LoadPageAsync(string? cursor)
    {
        _loading = true;
        _listError = null;
        var result = await Api.ListPetsResultAsync(limit: PageSize, cursor: cursor);
        _loading = false;
        if (result.Error is { } error)
        {
            _listError = error;
            return;
        }

        (_pets ??= []).AddRange(result.Value!.Items);
        _nextCursor = result.Value.NextCursor;
    }

    private async Task CreateAsync()
    {
        _createError = null;
        _creating = true;
        var result = await Api.CreatePetResultAsync(_new);
        _creating = false;
        if (result.Error is { } error)
        {
            _createError = error;
            return;
        }

        // Start the list over so the new pet shows up.
        _new = NewModel();
        await ReloadAsync();
    }

    private static NewPet NewModel() => new() { Name = string.Empty, Kind = "dog" };
}
