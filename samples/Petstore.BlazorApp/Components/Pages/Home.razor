@page "/"
@implements IDisposable
@inject IPetstoreClient Api
@inject ToastService Toasts

<PageTitle>Pets · Petstore</PageTitle>

<div class="page-header">
    <div>
        <h1>Pets</h1>
        <p class="lead">
            Cursor pagination with <code>ListPetsResultAsync</code>: each page carries the cursor of the next one, the
            <code>status</code> filter is a typed enum and the total comes from the <code>X-Total-Count</code> header.
        </p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-primary" @onclick="() => _showForm = !_showForm" aria-expanded="@_showForm">
            <Icon Name="@(_showForm ? "x" : "plus")" /> @(_showForm ? "Close" : "Add pet")
        </button>
    </div>
</div>

@if (_showForm)
{
    <NewPetForm OnCreated="CreatedAsync" OnClose="() => _showForm = false" />
}

<div class="toolbar">
    <div class="segmented" role="group" aria-label="Filter by status">
        @foreach (var (label, status) in Filters)
        {
            <button type="button" class="@(_status == status ? "active" : null)" aria-pressed="@(_status == status)" @onclick="() => FilterAsync(status)">
                @if (status is { } s)
                {
                    <span class="dot dot-@PetStatusJsonConverter.ToWireValue(s)"></span>
                }
                @label
            </button>
        }
    </div>
    <span class="muted small">
        @if (_pets is not null)
        {
            @($"Showing {_pets.Count} of {_total?.ToString() ?? "?"} pets")
        }
    </span>
</div>

@if (_listError is { } error && _pets is null)
{
    <ApiErrorView Error="error" OnRetry="ReloadAsync" />
}
else if (_pets is null)
{
    <div class="pet-grid" aria-busy="true" aria-label="Loading pets">
        @for (var i = 0; i < PageSize; i++)
        {
            <div class="skeleton skeleton-card"></div>
        }
    </div>
}
else if (_pets.Count == 0)
{
    <div class="card">
        <div class="empty">
            <span class="emoji" aria-hidden="true">🐾</span>
            <h2>No pets here</h2>
            <p>Nothing matches this filter. Add a pet or pick another status.</p>
        </div>
    </div>
}
else
{
    <div class="pet-grid">
        @foreach (var pet in _pets)
        {
            <PetCard Pet="pet" @key="pet.Id" />
        }
    </div>

    <div class="list-footer">
        @if (_listError is { } pageError)
        {
            <ApiErrorView Error="pageError" OnRetry="LoadMoreAsync" />
        }
        else if (_nextCursor is not null)
        {
            <button type="button" class="btn" disabled="@_loading" @onclick="LoadMoreAsync">
                @if (_loading)
                {
                    <span class="spinner"></span>
                }
                Load more
            </button>
            <span class="hint">Next cursor: <code>@_nextCursor</code></span>
        }
        else
        {
            <span class="hint">That's everyone: the last page has no <code>nextCursor</code>.</span>
        }
    </div>
}

@code {
    private const int PageSize = 6;

    private static readonly (string Label, PetStatus? Status)[] Filters =
    [
        ("All", null),
        ("Available", PetStatus.Available),
        ("Pending", PetStatus.Pending),
        ("Adopted", PetStatus.Sold),
    ];

    private CancellationTokenSource? _cancellation;
    private PetStatus? _status;
    private List<Pet>? _pets;
    private string? _nextCursor;
    private long? _total;
    private bool _loading;
    private ApiError? _listError;
    private bool _showForm;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task FilterAsync(PetStatus? status)
    {
        _status = status;
        return ReloadAsync();
    }

    private Task ReloadAsync()
    {
        _pets = null;
        _nextCursor = null;
        return LoadPageAsync(cursor: null);
    }

    private Task LoadMoreAsync() => LoadPageAsync(_nextCursor);

    private async Task LoadPageAsync(string? cursor)
    {
        // A newer load (another filter, say) cancels the one in flight.
        _cancellation?.Cancel();
        _cancellation?.Dispose();
        var cancellation = _cancellation = new CancellationTokenSource();

        _loading = true;
        _listError = null;
        try
        {
            var result = await Api.ListPetsResultAsync(limit: PageSize, cursor: cursor, status: _status, cancellationToken: cancellation.Token);
            if (result.Error is { } error)
            {
                _listError = error;
                return;
            }

            (_pets ??= []).AddRange(result.Value!.Items);
            _nextCursor = result.Value.NextCursor;
            _total = long.TryParse(result.GetHeader("X-Total-Count"), out var total) ? total : null;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        finally
        {
            if (ReferenceEquals(cancellation, _cancellation))
            {
                _loading = false;
            }
        }
    }

    private async Task CreatedAsync(Pet pet)
    {
        _showForm = false;
        Toasts.Show($"{pet.Name} joined the store (#{pet.Id}).");
        await ReloadAsync();
    }

    public void Dispose()
    {
        _cancellation?.Cancel();
        _cancellation?.Dispose();
    }
}
