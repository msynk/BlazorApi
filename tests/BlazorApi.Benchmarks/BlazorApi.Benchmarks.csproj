<Project Sdk="Microsoft.NET.Sdk">

  <!-- BenchmarkDotNet suite: parsing, reference resolution, model building, code generation, and generated client
       execution (request building, JSON reading) against an in-memory handler. Run with:
       dotnet run -c Release (from tests/BlazorApi.Benchmarks), then pick the benchmarks. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1707;CA1515;CA1822;CA2007;CA1001;CA1050</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlazorApi.CodeGeneration\BlazorApi.CodeGeneration.csproj" />
    <ProjectReference Include="..\..\src\BlazorApi.Runtime\BlazorApi.Runtime.csproj" />
    <ProjectReference Include="..\..\src\BlazorApi.DotNetQuery\BlazorApi.DotNetQuery.csproj" />
    <ProjectReference Include="..\..\src\BlazorApi.Testing\BlazorApi.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Golden\petstore\**\*.cs" Exclude="..\Golden\**\*.received.cs" LinkBase="Golden" />
    <None Include="..\Contracts\**\*" LinkBase="Contracts" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
