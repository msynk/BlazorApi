<Project Sdk="Microsoft.NET.Sdk">

  <!-- Native AOT smoke test (CI): a client generated by the BlazorApi source generator with GenerateJsonContext=true,
       published with PublishAot and reflection-based JSON disabled, run against `api-gen mock` (see
       .github/workflows/ci.yml). Not part of BlazorApi.slnx: it is only published, not unit tested. -->
  <Import Project="..\..\src\BlazorApi.SourceGenerator\build\BlazorApi.SourceGenerator.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>AotSmoke</RootNamespace>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlazorApi.SourceGenerator\BlazorApi.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\BlazorApi.Runtime\BlazorApi.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <OpenApiContract Include="..\Contracts\petstore.yaml" Namespace="AotSmoke.Petstore" Options="GenerateJsonContext=true" />
  </ItemGroup>

  <Import Project="..\..\src\BlazorApi.SourceGenerator\build\BlazorApi.SourceGenerator.targets" />

</Project>
