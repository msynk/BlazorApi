<Project Sdk="Microsoft.NET.Sdk">

  <!-- Native AOT smoke test (CI): a client generated by the CLI with generateJsonContext=true, published with
       PublishAot and reflection-based JSON disabled, run against `api-gen mock`. Not part of BlazorApi.slnx: its
       Generated folder is created by the CI step (see .github/workflows/ci.yml). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>AotSmoke</RootNamespace>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlazorApi.Runtime\BlazorApi.Runtime.csproj" />
  </ItemGroup>

</Project>
