{
  "openapi": "3.1.0",
  "info": { "title": "Features 3.1", "version": "2.0.0" },
  "servers": [
    {
      "url": "https://{region}.features.example.com/v2",
      "description": "Regional",
      "variables": { "region": { "default": "eu", "enum": ["eu", "us"] } }
    }
  ],
  "paths": {
    "/files/{id}": {
      "servers": [{ "url": "https://files.example.com" }],
      "get": {
        "operationId": "getFileInfo",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Info", "content": { "text/plain": { "schema": { "type": "string" } } } }
        }
      }
    },
    "/cars/{id}": {
      "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } } ],
      "get": {
        "operationId": "getCar",
        "responses": {
          "200": { "description": "Car", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Car" } } } }
        }
      },
      "put": {
        "operationId": "putCar",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Car" } } } },
        "responses": { "204": { "description": "Stored" } }
      }
    },
    "/search": {
      "query": {
        "operationId": "searchDocuments",
        "parameters": [
          {
            "name": "filter",
            "in": "querystring",
            "content": {
              "application/x-www-form-urlencoded": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "text": { "type": "string" },
                    "limit": { "type": "integer", "format": "int32" }
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matches",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Document" } } } }
          }
        }
      }
    },
    "/events": {
      "get": {
        "operationId": "streamEvents",
        "responses": {
          "200": {
            "description": "Events",
            "content": {
              "text/event-stream": { "itemSchema": { "$ref": "#/components/schemas/Progress" } }
            }
          }
        }
      }
    },
    "/exports": {
      "get": {
        "operationId": "exportShapes",
        "responses": {
          "200": {
            "description": "One shape per line",
            "content": {
              "application/jsonl": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Progress" } } }
            }
          }
        }
      }
    },
    "/shapes": {
      "get": {
        "operationId": "listShapes",
        "responses": {
          "200": {
            "description": "Shapes",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Shape" } }
              }
            }
          }
        }
      }
    },
    "/documents/{id}": {
      "additionalOperations": {
        "COPY": {
          "operationId": "copyDocument",
          "parameters": [
            { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
            { "name": "Destination", "in": "header", "required": true, "schema": { "type": "string" } }
          ],
          "responses": { "204": { "description": "Copied" } }
        }
      },
      "get": {
        "operationId": "getDocument",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Document",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Document" } } }
          },
          "202": {
            "description": "Still being processed",
            "headers": {
              "Retry-After": { "schema": { "type": "integer" } },
              "ETag": { "required": true, "schema": { "type": "string" } }
            },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Progress" } } }
          }
        }
      }
    }
  },
  "webhooks": {
    "shapeCreated": {
      "post": {
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Shape" } } } },
        "responses": { "200": { "description": "ok" } }
      }
    }
  },
  "components": {
    "schemas": {
      "Progress": {
        "type": "object",
        "required": ["percent", "stage"],
        "properties": {
          "percent": { "type": "integer", "format": "int32" },
          "stage": { "$ref": "#/components/schemas/Stage" }
        }
      },
      "Vehicle": {
        "type": "object",
        "required": ["vehicleType"],
        "discriminator": { "propertyName": "vehicleType" },
        "properties": {
          "vehicleType": { "type": "string" },
          "wheels": { "type": "integer", "format": "int32" }
        }
      },
      "Car": {
        "allOf": [
          { "$ref": "#/components/schemas/Vehicle" },
          { "type": "object", "required": ["seats"], "properties": { "seats": { "type": "integer", "format": "int32" } }, "additionalProperties": true }
        ]
      },
      "SportsCar": {
        "allOf": [
          { "$ref": "#/components/schemas/Car" },
          { "type": "object", "properties": { "topSpeed": { "type": "number" } } }
        ]
      },
      "Stage": { "type": "string", "enum": ["queued", "running", "done"] },
      "Shape": {
        "oneOf": [
          { "$ref": "#/components/schemas/Circle" },
          { "$ref": "#/components/schemas/Square" }
        ],
        "discriminator": { "propertyName": "shapeType" }
      },
      "Circle": {
        "type": "object",
        "required": ["shapeType", "radius"],
        "properties": {
          "shapeType": { "const": "Circle" },
          "radius": { "type": "number" }
        }
      },
      "Square": {
        "type": "object",
        "required": ["shapeType", "side"],
        "properties": {
          "shapeType": { "const": "Square" },
          "side": { "type": "number", "exclusiveMinimum": 0 }
        }
      },
      "Document": {
        "type": "object",
        "required": ["id", "title", "summary"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "examples": ["Quarterly report"] },
          "summary": { "type": ["string", "null"] },
          "parent": {
            "anyOf": [{ "$ref": "#/components/schemas/Document" }, { "type": "null" }]
          },
          "content": { "type": "string", "contentEncoding": "base64" },
          "labels": { "$ref": "#/components/schemas/Document/$defs/Labels", "description": "Document labels." }
        },
        "$defs": {
          "Labels": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  }
}
