@page "/docs/testing"
@inject ContractExplorer Explorer
@inject DemoSources Sources

<DocPage Href="docs/testing" Title="Testing"
         Lead="Test code that uses a generated client without running a server: generated mocks and fixtures for unit tests, MockApiHandler to run the real client against canned HTTP responses, and a contract check that fails when a change would break clients."
         Contents="@([("mocks", "Generated mocks"), ("fixtures", "Fixtures"), ("handler", "MockApiHandler"), ("compatibility", "Contract compatibility"), ("demo", "The demo test project")])">

    <Callout Kind="info">
        The examples come from <code>demo/BlazorApi.Demo.Tests</code>, which generates its own copy of the client with
        <code>GenerateMocks=true</code>. Its files are shown at the bottom of this page.
    </Callout>

    <section id="mocks">
        <h2>Generated mocks</h2>
        <p>
            Turn on <code>GenerateMocks</code> and reference <code>BlazorApi.Testing</code>. Each client gets a
            <code>{Client}Mock</code> that implements the interface, with a chainable <code>Setup{Operation}</code> per
            operation and verification helpers:
        </p>
        <CodeBlock Language="xml" Code="@MockItem" />
        <CodeBlock Language="csharp" Title="AdoptionServiceTests.cs" SourcePath="BlazorApi.Demo.Tests/AdoptionServiceTests.cs" Code="@MockTest" />
        <p>These are the members generated for this contract (from the generator, run with <code>GenerateMocks=true</code>):</p>
        <CodeBlock Language="csharp" Title="PetstoreClientMock (public members)" MaxHeight="340px" Code="@MockMembers" />
        <div class="table-scroll">
            <table class="api-table">
                <thead><tr><th>Inherited from <code>ApiMock</code></th><th>Effect</th></tr></thead>
                <tbody>
                    <tr><td><code>SetupError(id, status, content)</code></td><td>Fail with an HTTP error; <code>content</code> becomes <code>ApiError.Content</code>.</td></tr>
                    <tr><td><code>SetupNetworkFailure</code>, <code>SetupTimeout</code></td><td>Fail like a real client would.</td></tr>
                    <tr><td><code>SetupDelay(id, delay)</code></td><td>Delay the answer (cancellation is honored), for loading states.</td></tr>
                    <tr><td><code>Verify(id, times)</code>, <code>Verify(id, predicate)</code>, <code>VerifyNoOtherCalls</code></td><td>Check calls; arguments by parameter name (<code>call.Argument&lt;long&gt;("petId")</code>).</td></tr>
                </tbody>
            </table>
        </div>
        <p>Operations without a setup answer HTTP 501, so a missing setup is visible rather than silently null.</p>
    </section>

    <section id="fixtures">
        <h2>Fixtures</h2>
        <p>
            <code>PetstoreFixtures.Create{Model}(configure)</code> builds valid instances with every required property set
            (from examples, defaults or type-appropriate values). Values are deterministic, so they suit snapshot tests.
        </p>
        <CodeBlock Language="csharp" Code="@Fixtures" />
    </section>

    <section id="handler">
        <h2>MockApiHandler</h2>
        <p>
            To test serialization, parameters and handlers too, run the real generated client over
            <code>MockApiHandler</code>. It answers by operation id and records every request with its body:
        </p>
        <CodeBlock Language="csharp" Code="@Handler" />
        <p>With dependency injection, install it as the primary handler so your authentication handlers run as well:</p>
        <CodeBlock Language="csharp" Code="@HandlerDi" />
    </section>

    <section id="compatibility">
        <h2>Contract compatibility</h2>
        <p>
            Keep the last released contract in the repository and compare. <code>ContractComparer</code> classifies each
            change (breaking, risky, safe); the demo test fails on breaking changes. The same check is available as
            <code>api-gen diff</code> for CI.
        </p>
        <CodeBlock Language="csharp" Code="@Compatibility" />
    </section>

    <section id="demo">
        <h2>The demo test project</h2>
        <p>Run it with <code>dotnet test demo/BlazorApi.Demo.Tests</code>.</p>
        @foreach (var path in TestFiles)
        {
            <CodeBlock Language="@DemoSources.LanguageOf(path)" Title="@path" SourcePath="@path" Code="@Sources.Get(path)" LineNumbers="true" MaxHeight="420px" />
        }
    </section>
</DocPage>

@code {
    private static readonly string[] TestFiles = ["BlazorApi.Demo.Tests/AdoptionService.cs", "BlazorApi.Demo.Tests/AdoptionServiceTests.cs", "BlazorApi.Demo.Tests/BlazorApi.Demo.Tests.csproj"];

    private string? _mockMembers;

    private string MockMembers => _mockMembers ??= ReadMockMembers();

    private string ReadMockMembers()
    {
        {
            var result = ContractExplorer.Generate(Explorer.ContractText, ContractExplorer.DefaultOptions with { GenerateMocks = true });
            var mock = result.Files.FirstOrDefault(f => f.Path.EndsWith("ClientMock.g.cs", StringComparison.Ordinal));
            if (mock is null)
            {
                return "// No mock was generated.";
            }

            return string.Join("\n", mock.Content.Split('\n')
                .Select(l => l.TrimEnd('\r').Trim())
                .Where(l => l.StartsWith("public ", StringComparison.Ordinal) && l.Contains('(') && !l.Contains(" class ", StringComparison.Ordinal))
                .Select(l => ContractExplorer.Simplify(l.Split(" =>")[0].TrimEnd('{', ' ')) + ";")
                .Distinct());
        }
    }

    private const string MockItem = """
        <OpenApiContract Include="..\Contracts\petstore.yaml" Namespace="BlazorApi.Demo.Tests.Api" Options="GenerateMocks=true" />
        <PackageReference Include="BlazorApi.Testing" Version="0.1.0-preview" />
        """;

    private const string MockTest = """
        var mock = new PetstoreClientMock()
            .SetupGetPet(id => PetstoreFixtures.CreateDog(dog => { dog.Id = id; dog.Name = "Rex"; dog.Status = PetStatus.Available; }))
            .SetupPatchPet(PetstoreFixtures.CreateDog());

        var message = await new AdoptionService(mock).AdoptAsync(7);

        Assert.Equal("Rex has been adopted.", message);
        mock.Verify(PetstoreClientMock.Operations.PatchPet, call =>
            call.Argument<long>("petId") == 7 && call.Argument<PetPatch>("body").Tag.Value == "adopted");
        """;

    private const string Fixtures = """
        Dog dog = PetstoreFixtures.CreateDog(d => d.Name = "Rex");
        Pet pet = PetstoreFixtures.CreatePet();          // abstract root: its first concrete subtype (a Dog)
        PetPage page = PetstoreFixtures.CreatePetPage();
        """;

    private const string Handler = """"
        var handler = new MockApiHandler()
            .RespondJson("getPet", PetstoreFixtures.CreateCat(cat => { cat.Name = "Tom"; cat.Status = PetStatus.Available; }))
            .RespondJson("patchPet", PetstoreFixtures.CreateCat())
            .RespondOnce("listPets", HttpStatusCode.ServiceUnavailable)    // the first call only
            .Throw("getHealth", new HttpRequestException("offline"));
        var client = new PetstoreClient(new HttpClient(handler));

        var message = await new AdoptionService(client).AdoptAsync(3);

        var patch = Assert.Single(handler.RequestsTo("patchPet"));
        Assert.Equal("""{"tag":"adopted"}""", patch.Body);
        Assert.Equal("application/merge-patch+json", patch.Headers["Content-Type"].Split(';')[0]);
        """";

    private const string HandlerDi = """
        services.AddPetstoreClient()
            .AddBearerToken(_ => new StaticAccessTokenProvider("test"), "bearerAuth")
            .ConfigurePrimaryHttpMessageHandler(() => handler);
        """;

    private const string Compatibility = """
        static ApiModel Load(string path)
        {
            var result = OpenApiLoader.LoadFile(path);
            Assert.False(result.HasErrors, string.Join("\n", result.Diagnostics));
            return ApiModelBuilder.Build(result.Document!, new DiagnosticBag());
        }

        var report = ContractComparer.Compare(Load("Contracts/baseline/petstore.yaml"), Load("Contracts/petstore.yaml"));
        Assert.False(report.HasChangesAtLeast(ChangeSeverity.Breaking), report.ToText());
        """;
}
