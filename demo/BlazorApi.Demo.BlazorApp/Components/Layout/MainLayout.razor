@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<header class="topbar">
    <button type="button" class="btn btn-ghost menu-button" aria-label="Menu" aria-expanded="@_menuOpen" @onclick="() => _menuOpen = !_menuOpen">
        <Icon Name="@(_menuOpen ? "x" : "menu")" />
    </button>

    <a class="brand" href="">
        <span class="brand-mark" aria-hidden="true">🐾</span>
        <span>Petstore<small>BlazorApi demo</small></span>
    </a>

    <div class="topbar-end">
        <span class="badge badge-primary plain topbar-pill">Typed client generated from <code>petstore.yaml</code></span>
        <button type="button" class="btn btn-sm" aria-pressed="@ShowTraffic" @onclick="ToggleTraffic">
            <Icon Name="activity" />
            <span class="hide-sm">@(ShowTraffic ? "Hide traffic" : "Show traffic")</span>
        </button>
    </div>
</header>

<div class="shell @(ShowTraffic ? "with-traffic" : null)">
    <nav class="sidebar @(_menuOpen ? "open" : null)" aria-label="Main">
        @foreach (var section in SiteMap.Sections)
        {
            <div class="nav-section">
                <div class="nav-section-title">@section.Title</div>
                @foreach (var item in section.Items)
                {
                    <NavLink href="@item.Href" Match="@(item.Href.Length == 0 || item.Href.StartsWith("docs/", StringComparison.Ordinal) ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                        <Icon Name="@item.Icon" /> @item.Title
                    </NavLink>
                }
            </div>
        }
        <div class="sidebar-foot">
            <span class="hint">Data lives in memory and resets when the app restarts.</span>
        </div>
    </nav>
    @if (_menuOpen)
    {
        <div class="sidebar-backdrop" @onclick="() => _menuOpen = false"></div>
    }

    <main class="content">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="exception">
                <div class="card">
                    <div class="empty">
                        <span class="emoji" aria-hidden="true">🙀</span>
                        <h2>This page ran into a problem</h2>
                        <p>@exception.Message</p>
                        <button type="button" class="btn btn-primary" @onclick="Recover">Try again</button>
                    </div>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>

    @if (ShowTraffic)
    {
        <ApiTrafficPanel />
    }
</div>

<ToastHost />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">✕</span>
</div>

@code {
    // Pages that call the API show the traffic panel by default; reading pages hide it. A click on the toggle wins.
    private static readonly string[] QuietPages = ["", "code", "source"];

    private bool? _trafficChoice;
    private bool _menuOpen;
    private ErrorBoundary? _errorBoundary;

    private bool ShowTraffic => _trafficChoice ?? !IsQuietPage;

    private bool IsQuietPage
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
            var first = path.Split('/')[0];
            return QuietPages.Contains(first, StringComparer.OrdinalIgnoreCase);
        }
    }

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_menuOpen)
        {
            _menuOpen = false;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private void ToggleTraffic() => _trafficChoice = !ShowTraffic;

    private void Recover() => _errorBoundary?.Recover();

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
